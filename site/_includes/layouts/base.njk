<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}Loops</title>
    <link rel="stylesheet" href="/assets/css/base.css">
    {% for stylesheet in stylesheets | default([]) %}
      <link rel="stylesheet" href="{{ stylesheet }}">
    {% endfor %}
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Loops</a>
    </header>

    <main class="site-main">
      {{ content | safe }}
    </main>
  </body>
</html>
