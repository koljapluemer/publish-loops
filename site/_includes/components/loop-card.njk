{% macro loopCard(loop) %}
  <article class="loop-card">
    <a class="loop-card__link" href="{{ loop.url }}">
      <img
        class="loop-card__image"
        src="{{ loop.imageUrl }}"
        alt="Preview of {{ loop.title }}"
        loading="lazy"
      >
      <h2 class="loop-card__title">{{ loop.title }}</h2>
    </a>
  </article>
{% endmacro %}
